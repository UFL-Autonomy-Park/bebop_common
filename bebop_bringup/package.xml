<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bebop_bringup</name>
  <version>2.0.0</version>
  <description>Launch files that start the single-agent Parrot Bebop 2 stack (mocap, driver, teleop, rho filter, low-level controller, visualization). Off-board code runs on top of this.</description>
  <maintainer email="mgardenswartz@ufl.edu">Max Gardenswartz</maintainer>
  <license>MPL-2.0</license>
  <url type="repository">https://github.com/UFL-Autonomy-Park/bebop_common</url>
  <url type="bugtracker">https://github.com/UFL-Autonomy-Park/bebop_common/issues</url>
  <author email="mgardenswartz@ufl.edu">Max Gardenswartz</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>
  <exec_depend>ros2_bebop_driver</exec_depend>
  <exec_depend>bebop_teleop</exec_depend>
  <exec_depend>bebop_control</exec_depend>
  <exec_depend>rho_filter</exec_depend>
  <exec_depend>indoor_lab_viz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
