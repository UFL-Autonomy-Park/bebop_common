<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bebop_guidance</name>
  <version>2.0.0</version>
  <description>Example off-board trajectory-tracking controller (RISE) for a single Bebop 2, built on bebop_bringup. Takes a desired trajectory and the Bebop pose and outputs a desired velocity.</description>
  <maintainer email="mgardenswartz@ufl.edu">Max Gardenswartz</maintainer>
  <license>MPL-2.0</license>
  <url type="repository">https://github.com/UFL-Autonomy-Park/bebop_common</url>
  <url type="bugtracker">https://github.com/UFL-Autonomy-Park/bebop_common/issues</url>
  <author email="mgardenswartz@ufl.edu">Max Gardenswartz</author>
  <author email="brandonfallin@ufl.edu">Brandon Fallin</author>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>bebop_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
